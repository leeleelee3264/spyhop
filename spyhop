#!/usr/bin/env bash
# Spyhop launcher.
#
#   ./spyhop                 start the board and open it
#                            (with Orca: in a "Spyhop" workspace under the ~/.spyhop project; otherwise in the default browser)
#   ./spyhop --stop          stop the board
#   ./spyhop --autostart     start the board at login (LaunchAgent)
#   ./spyhop --no-autostart  remove the login item
#
# Your own repositories are never touched. ~/.spyhop is a tiny empty git repo created once,
# because Orca only registers git repos from the CLI.
set -e
d=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
home="$HOME/.spyhop"
loader="file://$home/open.html"

if [ "${1:-}" = "--autostart" ]; then python3 "$d/board.py" --autostart on; exit 0; fi
if [ "${1:-}" = "--no-autostart" ]; then python3 "$d/board.py" --autostart off; exit 0; fi
if [ "${1:-}" = "--stop" ]; then pkill -f "board.py --watch" && echo "stopped" || echo "not running"; exit 0; fi

python3 "$d/board.py" --ensure >/dev/null
if command -v orca >/dev/null && orca status --json >/dev/null 2>&1; then
  mkdir -p "$home"
  if [ ! -d "$home/.git" ]; then
    git -C "$home" init -q -b main
    printf 'config.json\nopen.html\n' > "$home/.gitignore"
    git -C "$home" add .gitignore
    git -C "$home" -c user.name=spyhop -c user.email=spyhop@localhost commit -q -m "spyhop board home"
  fi
  wid="$(orca worktree list --json | python3 -c "
import json,sys,os
ws=json.load(sys.stdin)['result']['worktrees']
print(next((w['id'] for w in ws if w.get('path')==os.path.expanduser('~/.spyhop') and not w.get('isArchived')),''))")"
  if [ -z "$wid" ]; then
    orca repo add --path "$home" --json >/dev/null
    wid="$(orca worktree list --json | python3 -c "
import json,sys,os
ws=json.load(sys.stdin)['result']['worktrees']
print(next((w['id'] for w in ws if w.get('path')==os.path.expanduser('~/.spyhop')),''))")"
    orca worktree set --worktree "id:$wid" --display-name Spyhop --json >/dev/null
  fi
  if ! orca tab list --worktree "id:$wid" --json 2>/dev/null | grep -qE '127.0.0.1:47613|spyhop/open.html'; then
    orca tab create --worktree "id:$wid" --url "$loader" --json >/dev/null
  fi
  echo "opened: orca workspace Spyhop"
  exit 0
fi
open "$loader" && echo "opened: browser $loader"
